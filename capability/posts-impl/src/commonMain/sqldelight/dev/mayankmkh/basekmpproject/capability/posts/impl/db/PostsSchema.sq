-- The durable source of truth for the posts feed that the UI observes:
-- the network writes into it and never reaches the presentation layer directly, so persisted rows
-- render offline and a refresh shows up as a table change rather than as a separate result.
CREATE TABLE post (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    -- SQLite appends columns added by migrations, so .sq must match the migrated table's exact
    -- column order and default for the assembly verification diff.
    author_id INTEGER NOT NULL DEFAULT 0
);

-- Version 4 drops the former post.position column with SQLite's rename-copy pattern. Leaving an
-- unused order column on entity rows would allow feed membership and entity data to drift.
CREATE TABLE postFeedEntry (
    -- replaceFeed guarantees integrity by writing entity rows before entries in one transaction.
    post_id TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL
);

CREATE INDEX postFeedEntry_position ON postFeedEntry(position);

-- A row exists once the feed endpoint has returned successfully, including when it returned an
-- empty list. Keeping this beside the rows makes "not fetched yet" distinguishable from "fetched
-- and empty" without preferences that could drift away from the database.
CREATE TABLE postFeedState (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 0)
);

selectFeed:
SELECT post.id, post.title, post.body, post.author_id
FROM postFeedEntry
INNER JOIN post ON post.id = postFeedEntry.post_id
ORDER BY postFeedEntry.position;

selectById:
SELECT id, title, body, author_id
FROM post
WHERE id = ?;

upsert:
INSERT OR REPLACE INTO post(id, author_id, title, body)
VALUES (?, ?, ?, ?);

deleteFeedEntries:
DELETE FROM postFeedEntry;

insertFeedEntry:
INSERT INTO postFeedEntry(post_id, position)
VALUES (?, ?);

countAll:
SELECT count(*)
FROM post;

feedInitializationCount:
SELECT count(*)
FROM postFeedState;

markFeedInitialized:
INSERT OR IGNORE INTO postFeedState(singleton)
VALUES (0);

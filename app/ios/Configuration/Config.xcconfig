// Everything a fork needs to change lives here, so the Xcode project itself stays untouched.
// TEAM_ID is your Apple Developer Team ID; leave it empty to build for the simulator only.
TEAM_ID=
PRODUCT_NAME=iosApp
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// The production identity. Staging derives from these two rather than restating them, so a fork
// that renames the app edits one line.
BASE_BUNDLE_IDENTIFIER=dev.mayankmkh.baseKmpProject
BASE_APP_DISPLAY_NAME=base_kmp_project

PRODUCT_BUNDLE_IDENTIFIER=$(BASE_BUNDLE_IDENTIFIER)
APP_DISPLAY_NAME=$(BASE_APP_DISPLAY_NAME)

// The shared module declares iosArm64 and iosSimulatorArm64 and no x86_64 simulator slice. A
// Debug configuration only builds the active architecture and never notices; a Release one builds
// every architecture the SDK offers, so it has to be told not to ask for the slice Gradle cannot
// produce. Device builds are untouched.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=x86_64

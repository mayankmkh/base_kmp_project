-- The durable source of truth for the posts feed that the UI observes:
-- the network writes into it and never reaches the presentation layer directly, so persisted rows
-- render offline and a refresh shows up as a table change rather than as a separate result.
CREATE TABLE post (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    -- Preserves feed order independently of `id`, which is text and would otherwise sort
    -- lexicographically ("10" before "2").
    position INTEGER NOT NULL,
    -- SQLite appends columns added by migrations, so .sq must match the migrated table's exact
    -- column order and default for the assembly verification diff.
    author_id INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX post_position ON post(position);

-- A row exists once the feed endpoint has returned successfully, including when it returned an
-- empty list. Keeping this beside the rows makes "not fetched yet" distinguishable from "fetched
-- and empty" without preferences that could drift away from the database.
CREATE TABLE postFeedState (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 0)
);

selectAll:
SELECT *
FROM post
ORDER BY position;

selectById:
SELECT *
FROM post
WHERE id = ?;

upsert:
INSERT OR REPLACE INTO post(id, author_id, title, body, position)
VALUES (?, ?, ?, ?, ?);

deleteAll:
DELETE FROM post;

countAll:
SELECT count(*)
FROM post;

feedInitializationCount:
SELECT count(*)
FROM postFeedState;

markFeedInitialized:
INSERT OR IGNORE INTO postFeedState(singleton)
VALUES (0);

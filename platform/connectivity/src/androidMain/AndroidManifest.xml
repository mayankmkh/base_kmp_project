<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared by the module that needs it, the way `:foundation:network` declares INTERNET:
         an app gets the permission by depending on the library, not by remembering to add it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>

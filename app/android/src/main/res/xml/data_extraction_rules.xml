<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above. Same exclusion as backup_rules.xml for both cloud backup and
  device-to-device transfer; the wrapped Tink keyset is only readable on the device that created it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dev.mayankmkh.basekmpproject.secure-storage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dev.mayankmkh.basekmpproject.secure-storage.xml"/>
    </device-transfer>
</data-extraction-rules>
